{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/bomb",
      "destination": "/ready",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/files/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ]
}