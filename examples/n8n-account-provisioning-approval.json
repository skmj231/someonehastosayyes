{
  "name": "Approval: Employee account provisioning approval",
  "nodes": [
    {
      "parameters": {},
      "name": "Hire ready",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://someonehastosayyes.com/v1/approvals",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer PASTE_YOUR_API_KEY"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ question: \"Provision accounts for this new employee?\", context: {\"action\":\"employee.provision\",\"employee\":\"Replace with employee\",\"role\":\"Replace with role\",\"start_date\":\"YYYY-MM-DD\",\"systems\":[\"Email\",\"Slack\",\"1Password\"]}, approve_label: \"Provision access\", reject_label: \"Do not provision\", channel: 'email', to: 'YOUR_APPROVER_EMAIL', callback_url: $execution.resumeUrl, timeout_minutes: 1440, default_on_timeout: 'rejected' }) }}",
        "options": {}
      },
      "name": "Request access approval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "resume": "webhook",
        "httpMethod": "POST",
        "limitWaitTime": true,
        "resumeAmount": 1445,
        "resumeUnit": "minutes",
        "options": {}
      },
      "name": "Wait for decision",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        500,
        0
      ],
      "webhookId": "shsy-account-provisioning-0001"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "approved",
              "leftValue": "={{ $json.body.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        760,
        0
      ]
    },
    {
      "parameters": {},
      "name": "CONNECT ACCOUNT CREATION HERE",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1020,
        -120
      ]
    },
    {
      "parameters": {},
      "name": "Keep access closed / notify IT",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1020,
        120
      ]
    }
  ],
  "connections": {
    "Hire ready": {
      "main": [
        [
          {
            "node": "Request access approval",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request access approval": {
      "main": [
        [
          {
            "node": "Wait for decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait for decision": {
      "main": [
        [
          {
            "node": "Approved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved?": {
      "main": [
        [
          {
            "node": "CONNECT ACCOUNT CREATION HERE",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Keep access closed / notify IT",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
