PORT=3000
NODE_ENV=production
BASE_URL=https://approve.yourdomain.com   # 승인 페이지 링크에 쓰임. 반드시 외부 접근 가능한 주소
API_KEYS=replace-with-a-random-api-key    # 쉼표로 여러 개. Authorization: Bearer <key>
SIGNING_SECRET=replace-with-32-random-characters  # Slack OAuth 상태 보호용
ADMIN_SECRET=replace-with-24-random-characters
DB_PATH=./askhuman.db

# 선택: 이메일 채널 (resend.com 무료 구간으로 시작)
RESEND_API_KEY=
EMAIL_FROM=approvals@yourdomain.com
# 이메일 확인 후 자동 발급되는 실제 키의 초기 안전 한도
INITIAL_APPROVALS_MONTH=50
INITIAL_EMAILS_MONTH=30
INITIAL_PENDING_LIMIT=10
INITIAL_RPM_LIMIT=10
INITIAL_CALLBACK_DOMAINS=3

# 실시간 추정 비용 단가(USD). 공급자 계약 단가에 맞춰 조정.
COST_APPROVAL_REQUEST_USD=0.00002
COST_EMAIL_USD=0.0004
COST_CALLBACK_ATTEMPT_USD=0.00001
COST_DB_WRITE_USD=0.000001
NEW_ACCOUNT_DAILY_COST_GUARD_USD=5
GLOBAL_DAILY_COST_GUARD_USD=25

# 운영 기록/전달 상세/서명 영수증 보관 기간
DECISION_RETENTION_DAYS=90
DELIVERY_RETENTION_DAYS=30
RECEIPT_RETENTION_DAYS=365

# 선택: 슬랙 채널 (아래 README의 슬랙 앱 설정 5단계 참고)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# 운영자 알림을 받을 채널 ID. Slack을 쓰지 않으면 비워둡니다.
NOTIFY_SLACK_CHANNEL=
NOTIFY_SLACK_KEY=

# 평소에는 false. 로컬 복구에서만 직접 키 발급을 잠시 허용.
ALLOW_DIRECT_ADMIN_KEYS=false

# self-host 환경에서만 필요. 관리형 서비스는 false 유지.
ALLOW_PRIVATE_CALLBACKS=false
