PORT=3000
BASE_URL=https://approve.yourdomain.com   # 승인 페이지 링크에 쓰임. 반드시 외부 접근 가능한 주소
API_KEYS=change-me-1,change-me-2          # 쉼표로 여러 개. Authorization: Bearer <key>
SIGNING_SECRET=change-me                  # 콜백 서명(HMAC-SHA256) 비밀키
DB_PATH=./askhuman.db

# 선택: 이메일 채널 (resend.com 무료 구간으로 시작)
RESEND_API_KEY=
EMAIL_FROM=approvals@yourdomain.com

# 선택: 슬랙 채널 (아래 README의 슬랙 앱 설정 5단계 참고)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
